{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": { "@hivemind/view-sdk": ["./types/view-sdk/index.ts"] }
  },
  "include": ["views/*/src", "packages/*/views/*/src", "types"]
}
