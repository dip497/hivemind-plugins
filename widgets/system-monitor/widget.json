{
  "id": "@dip497/system-monitor",
  "name": "System monitor",
  "version": "1.0.0",
  "description": "This computer, live: processor use, memory and the programs using the most.",
  "icon": "icon.svg",
  "permissions": [
    "machine:usage"
  ],
  "options": [
    {
      "id": "sort",
      "label": "Busiest programs by",
      "type": "choice",
      "values": [
        "cpu",
        "memory"
      ],
      "labels": [
        "Processor",
        "Memory"
      ],
      "default": "cpu"
    },
    {
      "id": "count",
      "label": "Programs shown",
      "type": "number",
      "min": 0,
      "max": 10,
      "default": 5
    },
    {
      "id": "every",
      "label": "Read every (seconds)",
      "type": "number",
      "min": 1,
      "max": 10,
      "default": 1
    }
  ],
  "commands": [
    {
      "name": "usage",
      "description": "Show a reading of this computer, as the feeder sends it every second",
      "args": "{ cpu, cores, memory: { used, total }, programs: [{ name, processes, cpu, memory }] }"
    }
  ],
  "category": "monitoring"
}
